PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
QWEN_BASE_URL=https://votre-api.example/v1
QWEN_API_KEY=
QWEN_MODEL=qwen3.8-27b-abliterated
# Générés par make init : ne pas modifier après création du volume PostgreSQL.
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
# Générés par make init : secrets partagés de l'orchestrateur et de la recherche web.
ORCHESTRATEUR_TOKEN=
RECHERCHE_TOKEN=
SEARXNG_SECRET=
CRAWL4AI_API_TOKEN=
# Recherche web (SearXNG, Crawl4AI… ~2,5 Go de mémoire pendant une recherche) : décommenter pour l'activer.
#COMPOSE_PROFILES=recherche
# Facultatif : uniquement utilisé si aucun compte n’existe encore.
# Sinon, créer un compte avec make user.
BOOTSTRAP_USERNAME=
BOOTSTRAP_PASSWORD=
